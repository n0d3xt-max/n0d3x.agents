#!/usr/bin/python3
# omarchy:summary=Print the Gemini CLI usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Gemini CLI usage into one display-ready JSON record.

The CLI saves per-project chat checkpoints under ~/.gemini/tmp/<hash>/chats/
with token usage statistics per session. There is no local limits endpoint,
so the panel shows the same TOKENS BY DAY / TOKENS BY MODEL sections with no
LIMITS block. The panel only ever reads the JSON this prints.
"""

import argparse
import glob
import json
import os
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "gemini"
AGENT_NAME = "Gemini CLI"
AUTH_HELP = "Run `gemini` and sign in with your Google account."

now = datetime.now()
today = now.strftime("%Y-%m-%d")
recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}
today_tokens_by_model = {}
model_usage = {}
today_sessions = set()
active_days = set()

today_prompts = 0
today_total_tokens = 0
total_prompts = 0
total_sessions = set()


def local_day(value, fallback_path=None):
    if isinstance(value, (int, float)):
        ts = float(value)
        if ts > 10_000_000_000:
            ts = ts / 1000
        try:
            return datetime.fromtimestamp(ts).strftime("%Y-%m-%d")
        except Exception:
            pass
    elif value is not None:
        text = str(value)
        try:
            if text.endswith("Z"):
                dt = datetime.fromisoformat(text[:-1] + "+00:00")
            else:
                dt = datetime.fromisoformat(text)
            if dt.tzinfo is not None:
                dt = dt.astimezone()
            return dt.strftime("%Y-%m-%d")
        except Exception:
            pass
    if fallback_path is not None:
        try:
            return datetime.fromtimestamp(fallback_path.stat().st_mtime).strftime("%Y-%m-%d")
        except Exception:
            pass
    return today


def number(value):
    try:
        return int(value or 0)
    except Exception:
        return 0


def model_name(raw):
    value = str(raw or "gemini").rstrip("/").split("/")[-1]
    return value if value else "gemini"


def add_usage(day, session_key, model, input_tokens, output_tokens, cache_read, cache_write):
    global today_prompts, today_total_tokens, total_prompts
    total = input_tokens + output_tokens + cache_read + cache_write
    if total <= 0:
        return False
    total_prompts += 1
    total_sessions.add(session_key)
    active_days.add(day)
    bucket = model_usage.setdefault(model, {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    })
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens
    bucket["cacheReadInputTokens"] += cache_read
    bucket["cacheCreationInputTokens"] += cache_write
    if day in recent:
        recent[day]["messageCount"] += total
    if day == today:
        today_prompts += 1
        today_sessions.add(session_key)
        today_total_tokens += total
        today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total
    return True


def harvest_tokens(obj):
    """Best-effort token extraction across Gemini checkpoint shapes."""
    if not isinstance(obj, dict):
        return (0, 0, 0, 0)
    for key in ("tokens", "usage", "tokenUsage", "sessionInfo"):
        sub = obj.get(key)
        if isinstance(sub, dict):
            i = number(sub.get("inputTokens") or sub.get("input") or sub.get("promptTokenCount"))
            o = number(sub.get("outputTokens") or sub.get("output") or sub.get("candidatesTokenCount"))
            c = number(sub.get("cachedContentTokenCount") or sub.get("cacheRead") or
                       (sub.get("cache") or {}).get("read") if isinstance(sub.get("cache"), dict) else 0)
            if i or o or c:
                return (i, o, c, 0)
    i = number(obj.get("inputTokens") or obj.get("promptTokenCount"))
    o = number(obj.get("outputTokens") or obj.get("candidatesTokenCount"))
    c = number(obj.get("cachedContentTokenCount"))
    return (i, o, c, 0)


def scan_checkpoint(path):
    try:
        parsed = json.loads(path.read_text(errors="replace"))
    except Exception:
        return
    session_key = "gemini:" + path.stem
    model = "gemini"
    if isinstance(parsed, dict):
        for key in ("model", "modelId", "modelID"):
            if parsed.get(key):
                model = model_name(parsed[key])
                break
    messages = []
    if isinstance(parsed, dict):
        for key in ("messages", "history", "conversation", "turns"):
            if isinstance(parsed.get(key), list):
                messages = parsed[key]
                break
    elif isinstance(parsed, list):
        messages = parsed
    counted = 0
    for entry in messages:
        if not isinstance(entry, dict):
            continue
        role = str(entry.get("role") or "").lower()
        if role not in ("model", "assistant", "gemini"):
            continue
        i, o, c, w = harvest_tokens(entry)
        if not (i or o or c):
            i, o, c, w = harvest_tokens(parsed if isinstance(parsed, dict) else {})
            if not (i or o or c):
                continue
        day = local_day(entry.get("timestamp") or entry.get("time") or entry.get("createdAt"), path)
        if add_usage(day, session_key, model_name(entry.get("model") or model), i, o, c, w):
            counted += 1
    if counted == 0 and isinstance(parsed, dict):
        # Session-level totals without per-message detail: attribute once.
        i, o, c, w = harvest_tokens(parsed)
        if i or o or c:
            day = local_day(parsed.get("updatedAt") or parsed.get("timestamp"), path)
            add_usage(day, session_key, model, i, o, c, w)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    parser.parse_args()

    home = Path.home()
    gemini_home = home / ".gemini"
    chats = sorted(glob.glob(os.path.expanduser("~/.gemini/tmp/*/chats/*.json")))
    for match in chats[:2000]:
        try:
            scan_checkpoint(Path(match))
        except Exception:
            continue

    has_data = total_prompts > 0
    installed = gemini_home.exists()
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True if (installed or has_data) else False,
        "hasLocalStats": True,
        "tierLabel": "",
        "usageStatusText": "" if has_data else ("No Gemini sessions yet" if installed else "Gemini CLI not found"),
        "authHelpText": AUTH_HELP,
        "limits": [],
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total_tokens,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [recent[day] for day in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": len(total_sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
        "modelUsage": model_usage,
    }
    print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
    main()
