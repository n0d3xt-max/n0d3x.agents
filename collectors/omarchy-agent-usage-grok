#!/usr/bin/python3
# omarchy:summary=Print the Grok Code usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Grok Code usage into one display-ready JSON record.

Grok stores each session under ~/.grok/sessions/<cwd>/<session-id>/ ($GROK_HOME
overrides): summary.json carries model/timestamps/message counts and
signals.json carries token usage and turn counters. There is no local quota
endpoint, so the panel shows the same TOKENS BY DAY / TOKENS BY MODEL
sections with no LIMITS block. The panel only ever reads the JSON this prints.
"""

import argparse
import json
import os
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "grok"
AGENT_NAME = "Grok Code"
AUTH_HELP = "Run `grok login` to authenticate."

now = datetime.now()
today = now.strftime("%Y-%m-%d")
recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}
today_tokens_by_model = {}
model_usage = {}
today_sessions = set()
active_days = set()

today_prompts = 0
today_total_tokens = 0
total_prompts = 0
total_sessions = set()


def grok_home():
    override = os.environ.get("GROK_HOME", "").strip()
    if override:
        return Path(override)
    return Path.home() / ".grok"


def local_day(value):
    if isinstance(value, (int, float)):
        ts = float(value)
        if ts > 10_000_000_000:
            ts = ts / 1000
        try:
            return datetime.fromtimestamp(ts).strftime("%Y-%m-%d")
        except Exception:
            return today
    if value is not None:
        text = str(value)
        try:
            if text.endswith("Z"):
                dt = datetime.fromisoformat(text[:-1] + "+00:00")
            else:
                dt = datetime.fromisoformat(text)
            if dt.tzinfo is not None:
                dt = dt.astimezone()
            return dt.strftime("%Y-%m-%d")
        except Exception:
            pass
    return today


def number(value):
    try:
        return int(value or 0)
    except Exception:
        return 0


def model_name(raw):
    value = str(raw or "grok").rstrip("/").split("/")[-1]
    return value if value else "grok"


def add_usage(day, session_key, model, input_tokens, output_tokens, cache_read, cache_write):
    global today_prompts, today_total_tokens, total_prompts
    total = input_tokens + output_tokens + cache_read + cache_write
    if total <= 0:
        return False
    total_prompts += 1
    total_sessions.add(session_key)
    active_days.add(day)
    bucket = model_usage.setdefault(model, {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    })
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens
    bucket["cacheReadInputTokens"] += cache_read
    bucket["cacheCreationInputTokens"] += cache_write
    if day in recent:
        recent[day]["messageCount"] += total
    if day == today:
        today_prompts += 1
        today_sessions.add(session_key)
        today_total_tokens += total
        today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total
    return True


def read_json(path):
    try:
        return json.loads(path.read_text(errors="replace"))
    except Exception:
        return None


def signals_tokens(signals):
    if not isinstance(signals, dict):
        return (0, 0, 0, 0)
    for key in ("tokenUsage", "tokens", "usage"):
        sub = signals.get(key)
        if isinstance(sub, dict):
            i = number(sub.get("input") or sub.get("inputTokens") or sub.get("promptTokens"))
            o = number(sub.get("output") or sub.get("outputTokens") or sub.get("completionTokens"))
            cr = number(sub.get("cacheRead") or sub.get("cachedTokens") or sub.get("cacheReadTokens"))
            cw = number(sub.get("cacheWrite") or sub.get("cacheCreationTokens"))
            if i or o or cr or cw:
                return (i, o, cr, cw)
    i = number(signals.get("inputTokens") or signals.get("totalInputTokens"))
    o = number(signals.get("outputTokens") or signals.get("totalOutputTokens"))
    return (i, o, 0, 0)


def scan_session(session_dir):
    summary = read_json(session_dir / "summary.json")
    signals = read_json(session_dir / "signals.json")
    if not isinstance(summary, dict) and not isinstance(signals, dict):
        return
    session_key = "grok:" + session_dir.name
    model = model_name((summary or {}).get("modelId") or (summary or {}).get("model"))
    day = local_day((summary or {}).get("updatedAt") or (summary or {}).get("createdAt"))
    try:
        day = local_day(max(
            (session_dir / "summary.json").stat().st_mtime if (session_dir / "summary.json").exists() else 0,
            (summary or {}).get("updatedAt") or 0,
        )) if not (summary or {}).get("updatedAt") else day
    except Exception:
        pass
    i, o, cr, cw = signals_tokens(signals or {})
    if i or o or cr or cw:
        add_usage(day, session_key, model, i, o, cr, cw)
        return
    # No token signals: fall back to message counts as activity units.
    count = number((summary or {}).get("messageCount")) or number((summary or {}).get("message_count"))
    turns = number((signals or {}).get("turnCount")) or number((signals or {}).get("turns")) or 1
    for _ in range(min(max(count, turns), 500)):
        pass
    # One aggregated unit per session keeps the tab honest without token data.
    global today_prompts, today_total_tokens, total_prompts
    total_prompts += 1
    total_sessions.add(session_key)
    active_days.add(day)
    bucket = model_usage.setdefault(model, {
        "inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0,
    })
    bucket["outputTokens"] += 1
    if day in recent:
        recent[day]["messageCount"] += 1
    if day == today:
        today_prompts += 1
        today_sessions.add(session_key)
        today_total_tokens += 1
        today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + 1


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    parser.parse_args()

    home = grok_home()
    sessions_root = home / "sessions"
    session_dirs = []
    if sessions_root.is_dir():
        for cwd_group in sessions_root.iterdir():
            if not cwd_group.is_dir():
                continue
            for session_dir in cwd_group.iterdir():
                if session_dir.is_dir():
                    session_dirs.append(session_dir)
    for session_dir in session_dirs[:5000]:
        try:
            scan_session(session_dir)
        except Exception:
            continue

    has_data = total_prompts > 0
    installed = home.exists() and (home / "bin").exists() or sessions_root.is_dir() or (home / "config.toml").exists()
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True if (installed or has_data) else False,
        "hasLocalStats": True,
        "tierLabel": "",
        "usageStatusText": "" if has_data else ("No Grok sessions yet" if installed else "Grok Code not found"),
        "authHelpText": AUTH_HELP,
        "limits": [],
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total_tokens,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [recent[day] for day in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": len(total_sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
        "modelUsage": model_usage,
    }
    print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
    main()
