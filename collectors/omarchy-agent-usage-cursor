#!/usr/bin/python3
# omarchy:summary=Print the Cursor usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Cursor agent usage into one display-ready JSON record.

cursor-agent writes JSONL transcripts under
~/.cursor/projects/<project>/agent-transcripts/<session>/<session>.jsonl
($CURSOR_CONFIG_DIR overrides). Assistant turns are counted and any reported
token usage is attributed per model. Cloud quota has no local endpoint, so the
panel shows the same TOKENS BY DAY / TOKENS BY MODEL sections with no LIMITS
block. The panel only ever reads the JSON this prints.
"""

import argparse
import glob
import json
import os
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "cursor"
AGENT_NAME = "Cursor"
AUTH_HELP = "Run `cursor-agent` and sign in."

now = datetime.now()
today = now.strftime("%Y-%m-%d")
recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}
today_tokens_by_model = {}
model_usage = {}
today_sessions = set()
active_days = set()

today_prompts = 0
today_total_tokens = 0
total_prompts = 0
total_sessions = set()


def cursor_home():
    override = os.environ.get("CURSOR_CONFIG_DIR", "").strip()
    if override:
        return Path(override)
    return Path.home() / ".cursor"


def local_day(value, fallback_path=None):
    if isinstance(value, (int, float)):
        ts = float(value)
        if ts > 10_000_000_000:
            ts = ts / 1000
        try:
            return datetime.fromtimestamp(ts).strftime("%Y-%m-%d")
        except Exception:
            pass
    elif value is not None:
        text = str(value)
        try:
            if text.endswith("Z"):
                dt = datetime.fromisoformat(text[:-1] + "+00:00")
            else:
                dt = datetime.fromisoformat(text)
            if dt.tzinfo is not None:
                dt = dt.astimezone()
            return dt.strftime("%Y-%m-%d")
        except Exception:
            pass
    if fallback_path is not None:
        try:
            return datetime.fromtimestamp(fallback_path.stat().st_mtime).strftime("%Y-%m-%d")
        except Exception:
            pass
    return today


def number(value):
    try:
        return int(value or 0)
    except Exception:
        return 0


def model_name(raw):
    value = str(raw or "cursor").rstrip("/").split("/")[-1]
    return value if value else "cursor"


def add_usage(day, session_key, model, input_tokens, output_tokens, cache_read, cache_write):
    global today_prompts, today_total_tokens, total_prompts
    total = input_tokens + output_tokens + cache_read + cache_write
    if total <= 0:
        total = 1
        output_tokens = 1
    total_prompts += 1
    total_sessions.add(session_key)
    active_days.add(day)
    bucket = model_usage.setdefault(model, {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    })
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens
    bucket["cacheReadInputTokens"] += cache_read
    bucket["cacheCreationInputTokens"] += cache_write
    if day in recent:
        recent[day]["messageCount"] += total
    if day == today:
        today_prompts += 1
        today_sessions.add(session_key)
        today_total_tokens += total
        today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total


def harvest_tokens(entry):
    for key in ("usage", "tokens", "tokenUsage", "result"):
        sub = entry.get(key)
        if isinstance(sub, dict):
            i = number(sub.get("inputTokens") or sub.get("input") or sub.get("promptTokens"))
            o = number(sub.get("outputTokens") or sub.get("output") or sub.get("completionTokens"))
            cr = number(sub.get("cacheReadInputTokens") or sub.get("cachedTokens"))
            cw = number(sub.get("cacheCreationInputTokens"))
            if i or o or cr or cw:
                return (i, o, cr, cw)
    return (0, 0, 0, 0)


def scan_transcript(path):
    session_key = "cursor:" + path.parent.name
    try:
        handle = path.open(errors="replace")
    except Exception:
        return
    with handle:
        for raw in handle:
            raw = raw.strip()
            if not raw:
                continue
            try:
                entry = json.loads(raw)
            except Exception:
                continue
            if not isinstance(entry, dict):
                continue
            role = str(entry.get("role") or "").lower()
            entry_type = str(entry.get("type") or "").lower()
            is_assistant = role in ("assistant", "model", "ai", "agent") or entry_type in (
                "assistant", "ai", "result", "assistant_message")
            if not is_assistant:
                # AI-SDK part shapes carry tool calls without a top-level role.
                parts = entry.get("parts") or entry.get("content")
                if isinstance(parts, list) and any(
                        isinstance(p, dict) and str(p.get("type") or "").startswith("tool-") for p in parts):
                    is_assistant = True
                else:
                    continue
            i, o, cr, cw = harvest_tokens(entry)
            day = local_day(entry.get("timestamp") or entry.get("createdAt") or entry.get("time"), path)
            add_usage(day, session_key, model_name(entry.get("model") or entry.get("modelId")), i, o, cr, cw)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    parser.parse_args()

    home = cursor_home()
    transcripts = sorted(glob.glob(os.path.join(str(home), "projects", "*", "agent-transcripts", "*", "*.jsonl")))
    for match in transcripts[:3000]:
        try:
            scan_transcript(Path(match))
        except Exception:
            continue

    has_data = total_prompts > 0
    installed = home.exists()
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True if (installed or has_data) else False,
        "hasLocalStats": True,
        "tierLabel": "",
        "usageStatusText": "" if has_data else ("No Cursor sessions yet" if installed else "Cursor not found"),
        "authHelpText": AUTH_HELP,
        "limits": [],
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total_tokens,
        "todayTokensByModel": today_tokens_by_model,
        "recentDays": [recent[day] for day in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": len(total_sessions),
        "activeDays": len(active_days),
        "activeDates": sorted(active_days),
        "modelUsage": model_usage,
    }
    print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
    main()
